    {
      "dot": "cyan",
      "title": "Ingress & Full-Stack SSR",
      "items": [
        "Cloud Load Balancer terminates TLS :443 and fronts client traffic",
        "Express 5 boots Vite 8 SSR streaming React 19 HTML on hardcoded port 5002",
        "In-memory Unified Cache serves pre-rendered pages with sub-millisecond latency"
      ]
    },
    {
      "dot": "emerald",
      "title": "Strict Type Safety & Invariants",
      "items": [
        "Thin controllers validate requests with Zod schemas strictly from @run-remix/shared",
        "Service layer methods return ResultAsync directly with zero uncaught exceptions",
        "Opossum circuit breakers isolate external APIs and Postgres connections"
      ]
    },
    {
      "dot": "amber",
      "title": "Data Tier & Background Workers",
      "items": [
        "Neon Serverless PostgreSQL 17 manages durable state via WebSocket connection pooling",
        "Google Cloud Tasks dispatches background jobs (GLTF Draco compression, image variants, email)",
        "Worker endpoints authenticate webhook invocations via Google OIDC tokens"
      ]
    }
