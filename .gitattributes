# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Binary media assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf

# 3D Garment models
*.glb binary
*.gltf binary

# Font files
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Documents
*.pdf binary

# Test snapshots
e2e/**/__snapshots__/* binary linguist-generated
test-results/** binary linguist-generated
